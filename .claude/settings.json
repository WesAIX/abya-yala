{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/session-start.sh\"", "timeout": 60}]}
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/post-edit.sh\"", "timeout": 60, "statusMessage": "Проверяю правку"}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/commit-guard.sh\"", "timeout": 120}]
      }
    ]
  }
}
