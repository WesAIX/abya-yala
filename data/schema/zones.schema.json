{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zones.schema.json",
  "title": "Культурные зоны",
  "type": "object",
  "required": ["meta", "zones", "places"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "license"],
      "properties": {
        "title": {"type": "string"},
        "schema": {"type": "string"},
        "license": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "subtitle", "color", "description", "chapters", "label", "blobs", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string"},
          "subtitle": {"type": "string"},
          "color": {"description": "Имя токена без «--» из visuals/shared/tokens.css.", "enum": ["z-n", "z-t", "z-m", "z-s"]},
          "description": {"type": "string"},
          "chapters": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "label": {
            "description": "Точка подписи на карте; anchor — выравнивание текста относительно точки.",
            "type": "object",
            "required": ["lon", "lat", "anchor"],
            "additionalProperties": false,
            "properties": {
              "lon": {"$ref": "#/$defs/lon"},
              "lat": {"$ref": "#/$defs/lat"},
              "anchor": {"enum": ["start", "middle", "end"]}
            }
          },
          "blobs": {
            "description": "Пятна для размытой заливки: схема, а не граница.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["lon", "lat", "radius_km"],
              "additionalProperties": false,
              "properties": {
                "lon": {"$ref": "#/$defs/lon"},
                "lat": {"$ref": "#/$defs/lat"},
                "radius_km": {"type": "number", "exclusiveMinimum": 0, "maximum": 3000}
              }
            }
          },
          "sources": {"$ref": "genealogy.schema.json#/$defs/sources"},
          "todo": {"$ref": "genealogy.schema.json#/$defs/todo"}
        }
      }
    },
    "places": {
      "description": "Подписи на карте, не относящиеся к зонам.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "lon", "lat"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "lon": {"$ref": "#/$defs/lon"},
          "lat": {"$ref": "#/$defs/lat"},
          "note": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "lon": {"type": "number", "minimum": -180, "maximum": 180},
    "lat": {"type": "number", "minimum": -90, "maximum": 90}
  }
}
